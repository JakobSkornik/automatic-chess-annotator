    {
      "ply": 23,
      "san": "Nh4",
      "human_san": "Nh4",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "The strongest continuation is 12.Nh4, which holds the balance (+0.16, Stockfish:16) along [pv:Nh4 Rf7 O-O Nb6 Nxb6], steering toward a line where Black's pawn structure may weaken\u2014doubled, isolated, and backward pawns that can leave Black with doubled b-pawns and lasting structural targets. In return, Black's rooks could become more active on the open files. O-O leads to equality and remains a comparable alternative [pv:O-O Nb6 Nh4 Rf7 Nxb6], but Nh4 is the more precise way to keep the position level.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
      "human_only": false,
      "system_only": true,
      "neither": false
    },
    {
      "ply": 24,
      "san": "Nb6",
      "human_san": "Nb6",
      "san_match": true,
      "human_comment": "Not 12... Nd4 for 13. Bxd4 cxd4 14.\nBd5+ Kh8 15. Qe4 with the threats 16.Bxb7 and, more important, 16. Ng6+ hxg6\n17.Qh4+ mate.",
      "human_symbol": null,
      "system_comment": "",
      "system_symbol": null,
      "is_key_moment": false,
      "final_comment": false,
      "both_present": false,
      "human_only": true,
      "system_only": false,
      "neither": false
    },
    {
      "ply": 25,
      "san": "Nf5",
      "human_san": "Nf5",
      "san_match": true,
      "human_comment": "Not wasting time in the Knight exchange. Flohr wants\nto have a clear edge in the middlegame and is not afraid of doubling the\na-file pawn.",
      "human_symbol": null,
      "system_comment": "",
      "system_symbol": null,
      "is_key_moment": false,
      "final_comment": false,
      "both_present": false,
      "human_only": true,
