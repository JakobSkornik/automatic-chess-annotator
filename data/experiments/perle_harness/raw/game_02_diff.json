    {
      "ply": 30,
      "san": "exf4",
      "human_san": "exf4",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "15...exf4 is the most accurate reply, holding the balance (+0.08, Stockfish:16) by winning a pawn\u2014a direct material gain that improves Black's practical chances\u2014and the line [pv:exf4 gxf4 Re8 Be4 Kh8] may leave a White piece hanging for White to resolve. Bd6 is a comparable alternative, though it leads to a slight advantage for White after [pv:Bd6 Nxd6 Qxd6 fxe5 fxe5], where White's king could come under pressure and Black might open the f-file for the rook.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
      "human_only": false,
      "system_only": true,
      "neither": false
    },
    {
      "ply": 31,
      "san": "gxf4",
      "human_san": "gxf4",
      "san_match": true,
