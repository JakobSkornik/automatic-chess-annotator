    },
    {
      "ply": 47,
      "san": "Qxe2",
      "human_san": "Qxe2",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "Qxe2 is the most accurate move, holding the balance (+0.20, Stockfish:16) in [pv:Qxe2 bxc6 Nxd8 Nxe2 Kxe2]: White's king is safe, and Black's pawn structure is now weaker with doubled, isolated, and backward pawns\u2014often awkward to advance and defend. Kd1 leads to equality as a comparable option in [pv:Kd1 Be6 Qxe6 Rxe6 Nh6+], stripping Black of the bishop-pair advantage, but Qxe2 secures king safety and structural pressure together.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
      "human_only": false,
      "system_only": true,
      "neither": false
    },
    {
      "ply": 48,
      "san": "Nxe2",
      "human_san": "Nxe2",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "",
      "system_symbol": null,
      "is_key_moment": false,
      "final_comment": false,
      "both_present": false,
