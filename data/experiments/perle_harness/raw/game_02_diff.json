    {
      "ply": 54,
      "san": "Kg8",
      "human_san": "Kg8",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "Black's...Kg8 gives White a winning advantage (+1.53, Stockfish:16). The continuation [pv:Kg8 Kf2 Nh3+ Kg3 Nxf4] is instructive because, further along that line, White may win a knight for two pawns\u2014a material imbalance that typically favors the side with the piece when pawns cannot easily restrain the remaining army in the middlegame.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
