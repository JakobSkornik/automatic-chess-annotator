    {
      "ply": 46,
      "san": "Rxe2+",
      "human_san": "Rxe2+",
      "san_match": true,
      "human_comment": "If 23... Be6 then 24. Nxd8 Bxc4 25. Bxe8 gains material.",
      "human_symbol": null,
      "system_comment": "",
      "system_symbol": null,
      "is_key_moment": false,
