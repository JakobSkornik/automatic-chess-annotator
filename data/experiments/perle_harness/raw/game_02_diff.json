    {
      "ply": 32,
      "san": "Re8",
      "human_san": "Re8",
      "san_match": true,
      "human_comment": "Of course the\nPf4 is at present one of the \"untouchables\": 16... Nxf4 17. Qc4+ Ne6 18. Bd5\nQd7 19. Bxe6+ Qxe6 20. Nxe7+",
      "human_symbol": null,
      "system_comment": "",
      "system_symbol": null,
      "is_key_moment": false,
