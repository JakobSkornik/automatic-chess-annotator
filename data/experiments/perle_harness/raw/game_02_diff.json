      "san": "bxa4",
      "human_san": "bxa4",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "14.bxa4 is the strongest continuation, holding the balance (+0.12, Stockfish:16) along [pv:bxa4 Rb8 e3 Kh8 O-O], and may lead to a safer king for White as the line unfolds\u2014a practical edge when kingside pressure builds. A comparable option was 14.Nxe7+, which leads to equality in [pv:Nxe7+ Qxe7 bxa4 Kh8 h4], giving White a bishop for a knight and leaving Black without the bishop-pair advantage.",
      "system_symbol": "!",
      "is_key_moment": true,
