    {
      "ply": 17,
      "san": "Na4",
      "human_san": "Na4",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "The most accurate move holds the balance (+0.00, Stockfish:16) along [pv:Na4 Nd7 d3 f6 Nf3], immediately leaving Black with a hanging piece and putting pressure on weak enemy units\u2014forcing Black to address concrete threats rather than improve freely. Ne4, which leads to equality along [pv:Ne4 b6 Nc3 Qd7 Bxa8], is a comparable option that may eventually win the exchange for White, while the knight on a4 keeps that immediate pressure at the forefront as the middlegame unfolds.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
      "human_only": false,
      "system_only": true,
      "neither": false
    },
