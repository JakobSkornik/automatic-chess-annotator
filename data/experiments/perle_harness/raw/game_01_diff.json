      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "White's most accurate continuation, maintaining the advantage at (+0.32, Stockfish:16) on [pv:Bxc4 h6 Bh4 Nd5 Bg3], improves the pawn structure by resolving doubled, isolated, and backward pawn issues\u2014healthier pawn chains are typically easier to handle in the middlegame. Bxf6 leads to equality and is a comparable route through [pv:Bxf6 Nxf6 Bxc4 b6 e4], though that sequence may leave White with a knight for a bishop.",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
      "human_only": false,
      "system_only": true,
      "neither": false
