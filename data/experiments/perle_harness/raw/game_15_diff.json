    {
      "ply": 10,
      "san": "b6",
      "human_san": "b6",
      "san_match": true,
      "human_comment": "This move is a prelude\nto the developement of the Bishop in b7 or a6 and a plan for a contrast at the\ncenter with d7-d5 or a besiege to the c4 pawn using the maneuver Nb8-c6-a5.",
      "human_symbol": null,
      "system_comment": "The game transposes into the Nimzo-Indian: Saemisch, 5...b6 (E24).",
      "system_symbol": null,
      "is_key_moment": false,
      "final_comment": false,
      "both_present": true,
      "human_only": false,
      "system_only": false,
      "neither": false,
      "text_ratio": 0.1975,
      "text_jaccard": 0.0455
    },
    {
      "ply": 11,
      "san": "f3",
      "human_san": "f3",
      "san_match": true,
      "human_comment": "White, instead, is preparing a better control of the center with his pawns.",
      "human_symbol": null,
      "system_comment": "This is the last book move of the Nimzo-Indian: Saemisch, 5...b6 6.f3 (E24); both sides are on their own from here.",
      "system_symbol": null,
      "is_key_moment": false,
      "final_comment": false,
      "both_present": true,
      "human_only": false,
      "system_only": false,
