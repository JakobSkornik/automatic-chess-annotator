      "text_ratio": 0.3368,
      "text_jaccard": 0.0
    },
    {
      "ply": 12,
      "san": "d5",
      "human_san": "d5",
      "san_match": true,
      "human_comment": "",
      "human_symbol": null,
      "system_comment": "The most accurate move, holding the balance at (-0.03, Stockfish:16): [pv:d5 Nh3 O-O Nf2 c5]. It immediately leaves White with a hanging piece while preparing a pawn break on the d-file, and in the line Black\u2019s pieces may become more active while White\u2019s pawn structure could weaken with doubled, isolated, and backward pawns, at the cost of a back rank that could grow vulnerable. Castling with O-O was a comparable option that leads to equality, as [pv:O-O e4 d6 Bd3 Nc6].",
      "system_symbol": "!",
      "is_key_moment": true,
      "final_comment": true,
      "both_present": false,
